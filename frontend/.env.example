# EvidenceBridge Frontend Environment Configuration

# Backend API Base URL
# In development, leave blank or set to '/api/v1' (Vite proxies this to http://localhost:8000).
# In production (Netlify, Vercel, Cloudflare Pages, etc.), set to your deployed backend URL:
# Example: https://api.evidencebridge.org/api/v1
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# ElevenLabs Conversational AI (Public Agent ID - safe for client-side use)
# Obtain this from your ElevenLabs Conversational AI Agent dashboard.
# No private API key should ever be placed in client-side environment files.
VITE_ELEVENLABS_AGENT_ID=your_public_agent_id_here
